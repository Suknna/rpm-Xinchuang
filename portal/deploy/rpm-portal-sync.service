[Unit]
Description=Sync RPM download portal from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rpm-portal
Group=rpm-portal
ExecStart=/data/dist/venv/bin/python /data/dist/app/sync.py --config /data/dist/private/config.yaml
TimeoutStartSec=30min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/dist/private /data/dist/public/data /data/download
